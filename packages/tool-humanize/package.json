{
  "name": "dsh-tool-humanize",
  "version": "0.1.1",
  "description": "humanize_text tool + 去AI味 panel and settings for dsh web: rewrite a draft with the humanizer model — official prompt, hz chunking, keep-verbatim, number/copy/language checks, candidates",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "humanizer",
    "rewrite",
    "llm"
  ],
  "homepage": "https://github.com/Nothing1024/dsh-humanizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nothing1024/dsh-humanizer.git",
    "directory": "packages/tool-humanize"
  },
  "bugs": {
    "url": "https://github.com/Nothing1024/dsh-humanizer/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/*.d.ts",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "NOTICE",
    "LICENSE",
    "locale",
    "icon.svg",
    "docs"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsdown",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "icon": "./icon.svg"
}
